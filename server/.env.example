# Port for events from the AMXX mod (UDP, and TCP for tools/tcptester.js)
PORT_TCP=1337
PORT_HTTP=27016
WEBSERVER_HOST="localhost"
VITE_WEBSOCKET_URI="wss://localhost:27016"
VITE_BUILD_DIR="dist"
TMPDIR="/tmp/beercs"
# Where game history is read from and saved to (default: history)
#HISTORY_DIR="/tmp/beercs-history"
# Games with fewer rounds are ignored in stats and for LAN detection (default 8).
# Lower it when testing with short games.
#MIN_GAME_ROUNDS=1
